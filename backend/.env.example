# Server — Railway sets PORT automatically; local default matches FE API_DEFAULT_PORT
PORT=8387
NODE_ENV=development

# CORS — comma-separated origins (FE local + Vercel)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL — local docker-compose / Railway Postgres plugin
DATABASE_URL=postgresql://auco:auco@localhost:5433/auco?schema=public

# Redis — local docker-compose / Railway Redis plugin (BullMQ later)
REDIS_URL=redis://localhost:6380

# LLM gateway (Phase 3) — platform-managed keys, no BYOK
OPENAI_API_KEY=
GEMINI_API_KEY=
# Alias also accepted: GOOGLE_GENERATIVE_AI_API_KEY=
DEFAULT_LLM_MODEL=gpt-4o
FALLBACK_LLM_MODEL=gemini-2.0-flash
LLM_PRIMARY_RETRIES=2
LLM_TIMEOUT_MS=60000
# Smoke POST /api/llm/smoke — auto on in non-production; set true on Railway to test
LLM_SMOKE_ENABLED=false

# SHB MCP Suite (Phase 5) — Nest spawns stdio MCP servers
MCP_SUITE_ENABLED=true
MCP_BANK_CODE=SHB
