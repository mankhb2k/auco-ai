# Server — Railway sets PORT automatically; local default matches FE API_DEFAULT_PORT
PORT=8387
NODE_ENV=development

# CORS — comma-separated origins (FE local + Vercel)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL — local docker-compose / Railway Postgres plugin
DATABASE_URL=postgresql://auco:auco@localhost:5433/auco?schema=public

# Redis — local docker-compose / Railway Redis plugin (BullMQ later)
REDIS_URL=redis://localhost:6380

# LLM gateway (Phase 3) — platform-managed keys, no BYOK
OPENAI_API_KEY=
GEMINI_API_KEY=
# Alias also accepted: GOOGLE_GENERATIVE_AI_API_KEY=
DEFAULT_LLM_MODEL=gpt-4o
FALLBACK_LLM_MODEL=gemini-2.0-flash
LLM_PRIMARY_RETRIES=2
LLM_TIMEOUT_MS=60000

# Tier routing (§5.4) — gateway maps purpose → small/mid/large.
# Unset tiers fall back to DEFAULT_LLM_MODEL (single-model demo behavior).
# LLM_MODEL_SMALL=gpt-4o-mini
# LLM_MODEL_MID=gpt-4o
# LLM_MODEL_LARGE=gpt-4.1

# On-prem / VPC primary (production banks) — OpenAI-compatible endpoint
# (vLLM / TGI / Ollama / LiteLLM). Switch primary via LLM_PRIMARY_PROVIDER.
# LLM_PRIMARY_PROVIDER=onprem
# ONPREM_LLM_BASE_URL=http://vllm.internal.bank:8000/v1
# ONPREM_LLM_API_KEY=
# LLM_MODEL_SMALL=qwen2.5-7b-instruct
# LLM_MODEL_MID=qwen2.5-32b-instruct
# LLM_MODEL_LARGE=llama-3.3-70b-instruct
# Smoke POST /api/llm/smoke — auto on in non-production; set true on Railway to test
LLM_SMOKE_ENABLED=false

# SHB MCP Suite (Phase 5) — Nest spawns stdio MCP servers
MCP_SUITE_ENABLED=true
MCP_BANK_CODE=SHB

# RAG (Phase 6) — embeddings (defaults to OpenAI text-embedding-3-small)
EMBEDDING_MODEL=text-embedding-3-small
# Timeouts (ms) — tránh treo hot path khi provider/MCP stall
EMBEDDING_TIMEOUT_MS=20000
EMBEDDING_BATCH_TIMEOUT_MS=60000
MCP_CALL_TIMEOUT_MS=30000
