// Digital Expert Agents — Prisma schema (Phase 1)
// Models from README §§2.1, 2.6, 2.7, 4 — bankCode seam on core tables

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model TaskRun {
  id          String     @id @default(cuid())
  bankCode    String     @default("SHB")
  employeeId  String?
  employee    Employee?  @relation(fields: [employeeId], references: [id])
  goal        String     @db.Text
  status      String // planning | running | done | failed
  planJson    Json
  finalAnswer String?    @db.Text
  createdAt   DateTime   @default(now())
  steps       TaskStep[]

  @@index([bankCode])
  @@index([status])
  @@index([createdAt])
}

model TaskStep {
  id        String    @id @default(cuid())
  taskRunId String
  taskRun   TaskRun   @relation(fields: [taskRunId], references: [id], onDelete: Cascade)
  agentRole String // credit | legal | product | ops
  mode      String    @default("direct") // direct | spawn_workers
  input     Json
  output    Json?
  status    String // pending | running | waiting_approval | done | failed
  dependsOn String[]
  toolCalls Json[]    @default([])
  startedAt DateTime?
  finishedAt DateTime?

  @@index([taskRunId])
  @@index([status])
}

model Employee {
  id          String              @id @default(cuid())
  bankCode    String              @default("SHB")
  displayName String
  role        String // credit_officer | compliance_officer | ops_officer | branch_manager | it_admin
  /// role.md §1 — 3 lớp quyền demo: it_admin | manager | employee
  accessLayer String              @default("employee")
  branchCode  String?
  portfolios  CustomerPortfolio[]
  taskRuns    TaskRun[]
  uploadedKnowledgeDocuments KnowledgeDocument[] @relation("KnowledgeUploadedBy")
  knowledgeIngestJobs        KnowledgeIngestJob[] @relation("KnowledgeIngestCreatedBy")
  knowledgeChangeReviews     KnowledgeChangeProposal[] @relation("KnowledgeProposalReviewedBy")

  @@index([bankCode])
}

model Customer {
  id         String              @id @default(cuid())
  bankCode   String              @default("SHB")
  fullName   String
  customerNo String
  branchCode String?
  /// Full FE mock profile (cic, income, demoTag, etc.) — Phase 2 seed
  profileJson Json?
  portfolios CustomerPortfolio[]

  @@unique([bankCode, customerNo])
  @@index([bankCode])
}

model CustomerPortfolio {
  id         String   @id @default(cuid())
  employeeId String
  customerId String
  bankCode   String   @default("SHB")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([employeeId, customerId])
  @@index([bankCode])
}

model Automation {
  id                 String          @id @default(cuid())
  bankCode           String          @default("SHB")
  name               String
  description        String?         @db.Text
  createdByAgentRole String
  triggerType        String // schedule | manual
  cronExpr           String?
  timezone           String          @default("Asia/Ho_Chi_Minh")
  enabled            Boolean         @default(false)
  status             String // draft | pending_approval | active | paused
  graphJson          Json? // pinned step graph (trigger/extract/llm-transform/notification)
  botVersionId       String?
  lastRunAt          DateTime?
  nextRunAt          DateTime?
  createdAt          DateTime        @default(now())
  runs               AutomationRun[]

  @@index([bankCode])
  @@index([enabled])
}

model AutomationRun {
  id            String     @id @default(cuid())
  automationId  String
  automation    Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  status        String // running | done | failed
  startedAt     DateTime   @default(now())
  finishedAt    DateTime?
  resultSummary String?    @db.Text
  traceJson     Json?
  actorId       String? // who triggered (user/system)

  @@index([automationId])
  @@index([status])
}

model KnowledgeDocument {
  id            String             @id @default(cuid())
  domain        String // credit | legal | product | ops
  bankCode      String             @default("SHB")
  title         String
  sourceUrl     String?
  content       String             @db.Text
  status        String             @default("draft") // draft | active | superseded
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  uploadedById  String?
  uploadedBy    Employee?          @relation("KnowledgeUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  publishedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  relationsFrom DocumentRelation[] @relation("FromDoc")
  relationsTo   DocumentRelation[] @relation("ToDoc")

  @@index([bankCode, domain])
  @@index([status])
  @@index([uploadedById])
}

model DocumentRelation {
  id           String            @id @default(cuid())
  fromDocId    String
  toDocId      String
  relationType String // amends | supersedes | replaces_clause
  note         String?           @db.Text
  fromDoc      KnowledgeDocument @relation("FromDoc", fields: [fromDocId], references: [id], onDelete: Cascade)
  toDoc        KnowledgeDocument @relation("ToDoc", fields: [toDocId], references: [id], onDelete: Cascade)

  @@index([fromDocId])
  @@index([toDocId])
}

/// role.md Phase R6 — upload/URL → Curator → manager review (không auto-publish)
model KnowledgeIngestJob {
  id           String                   @id @default(cuid())
  bankCode     String                   @default("SHB")
  domain       String // credit | legal | product | ops
  sourceType   String // upload | url
  sourceUri    String?
  fileName     String?
  rawText      String                   @db.Text
  status       String                   @default("queued") // queued | parsing | analyzing | pending_review | applied | rejected | failed
  errorMessage String?                  @db.Text
  createdById  String?
  createdBy    Employee?                @relation("KnowledgeIngestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  proposal     KnowledgeChangeProposal?

  @@index([bankCode, domain])
  @@index([status])
  @@index([createdById])
}

model KnowledgeChangeProposal {
  id             String             @id @default(cuid())
  jobId          String             @unique
  job            KnowledgeIngestJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  bankCode       String             @default("SHB")
  domain         String
  status         String             @default("pending_review") // pending_review | approved | rejected
  summary        String             @db.Text
  operationsJson Json
  confidence     Float?
  warningsJson   Json?
  reviewedById   String?
  reviewedBy     Employee?          @relation("KnowledgeProposalReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  reviewNote     String?            @db.Text
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([bankCode, domain])
  @@index([status])
  @@index([reviewedById])
}

/// role.md Phase R5 — audit log demo tối thiểu (không thay SIEM)
model AuditEvent {
  id         String   @id @default(cuid())
  bankCode   String   @default("SHB")
  actorId    String
  action     String // task_run.create | approval.approve | knowledge.publish | mcp.connector.set_enabled ...
  resource   String // TaskRun:id | TaskStep:id | KnowledgeDocument:id | McpConnector:capability
  detailJson Json?
  createdAt  DateTime @default(now())

  @@index([bankCode, createdAt])
  @@index([actorId])
  @@index([action])
}
