// Digital Expert Agents — Prisma schema (Phase 1)
// Models from README §§2.1, 2.6, 2.7, 4 — bankCode seam on core tables

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model TaskRun {
  id          String       @id @default(cuid())
  bankCode    String       @default("SHB")
  employeeId  String?
  employee    Employee?    @relation(fields: [employeeId], references: [id])
  goal        String       @db.Text
  status      String // planning | running | done | failed
  planJson    Json
  finalAnswer String?      @db.Text
  /// Nhãn đề xuất tính deterministic từ policy gate (LTV/AML) sau khi có đủ
  /// output 3 expert — không phải LLM tự đoán từ finalAnswer. Xem
  /// PlannerService.computePolicyGate().
  suggestedAssessmentTag String?
  /// Lý do policy gate ép nhãn (ví dụ "LTV 82% vượt ngưỡng 75%") — rỗng nếu
  /// không có rule nào bị vi phạm.
  policyGateReasons      String[] @default([])
  createdAt   DateTime     @default(now())
  steps       TaskStep[]
  loanRequest LoanRequest?

  @@index([bankCode])
  @@index([status])
  @@index([createdAt])
}

model TaskStep {
  id         String    @id @default(cuid())
  taskRunId  String
  taskRun    TaskRun   @relation(fields: [taskRunId], references: [id], onDelete: Cascade)
  agentRole  String // credit | legal | product | ops
  mode       String    @default("direct") // direct | spawn_workers
  input      Json
  output     Json?
  status     String // pending | running | waiting_approval | done | failed
  dependsOn  String[]
  toolCalls  Json[]    @default([])
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([taskRunId])
  @@index([status])
}

model Employee {
  id                         String                    @id @default(cuid())
  bankCode                   String                    @default("SHB")
  displayName                String
  role                       String // credit_officer | compliance_officer | ops_officer | branch_manager | it_admin
  /// role.md §1 — 3 lớp quyền demo: it_admin | manager | employee
  accessLayer                String                    @default("employee")
  branchCode                 String?
  portfolios                 CustomerPortfolio[]
  taskRuns                   TaskRun[]
  createdLoanRequests        LoanRequest[]             @relation("LoanRequestCreatedBy")
  assignedLoanRequests       LoanRequest[]             @relation("LoanRequestAssignedTo")
  submittedLoanRequests      LoanRequest[]             @relation("LoanRequestSubmittedBy")
  decidedLoanRequests        LoanRequest[]             @relation("LoanRequestDecidedBy")
  uploadedKnowledgeDocuments KnowledgeDocument[] @relation("KnowledgeUploadedBy")

  @@index([bankCode])
}

model Customer {
  id           String              @id @default(cuid())
  bankCode     String              @default("SHB")
  fullName     String
  customerNo   String
  branchCode   String?
  /// Full FE mock profile (cic, income, demoTag, etc.) — Phase 2 seed
  profileJson  Json?
  portfolios   CustomerPortfolio[]
  loanRequests LoanRequest[]

  @@unique([bankCode, customerNo])
  @@index([bankCode])
}

model CustomerPortfolio {
  id         String   @id @default(cuid())
  employeeId String
  customerId String
  bankCode   String   @default("SHB")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([employeeId, customerId])
  @@index([bankCode])
}

/// Yêu cầu vay giả lập nhận từ app ngân hàng; entity trung tâm của MVP đánh giá khoản vay.
model LoanRequest {
  id                     String    @id @default(cuid())
  bankCode               String    @default("SHB")
  externalRef            String    @unique
  customerId             String
  customer               Customer  @relation(fields: [customerId], references: [id])
  createdById            String?
  createdBy              Employee? @relation("LoanRequestCreatedBy", fields: [createdById], references: [id])
  assignedToId           String?
  assignedTo             Employee? @relation("LoanRequestAssignedTo", fields: [assignedToId], references: [id])
  assessmentTaskRunId    String?   @unique
  assessmentTaskRun      TaskRun?  @relation(fields: [assessmentTaskRunId], references: [id], onDelete: SetNull)
  requestedAmountVnd     Decimal   @db.Decimal(20, 0)
  loanPurpose            String
  requestedTermMonths    Int
  declaredIncomeVnd      Decimal?  @db.Decimal(20, 0)
  collateralType         String?
  estimatedCollateralVnd Decimal?  @db.Decimal(20, 0)
  source                 String    @default("mobile_app")
  note                   String?   @db.Text
  /// unassigned | assigned | assessing | advised | pending_approval | approved | rejected | escalated | needs_info | failed
  status                 String    @default("unassigned")
  assignedAt             DateTime?
  assessmentStartedAt    DateTime?
  /// recommend_approve | manual_review | needs_documents | recommend_reject
  assessmentTag          String?
  staffNote              String?   @db.Text
  submittedAt            DateTime?
  submittedById          String?
  submittedBy            Employee? @relation("LoanRequestSubmittedBy", fields: [submittedById], references: [id])
  /// approved | rejected | returned | escalated
  decision               String?
  decisionNote           String?   @db.Text
  decidedAt              DateTime?
  decidedById            String?
  decidedBy              Employee? @relation("LoanRequestDecidedBy", fields: [decidedById], references: [id])
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([bankCode, status, createdAt])
  @@index([bankCode, assignedToId, status])
  @@index([bankCode, assessmentTag])
  @@index([customerId])
}

model KnowledgeDocument {
  id            String             @id @default(cuid())
  domain        String // credit | legal | product | ops
  bankCode      String             @default("SHB")
  title         String
  sourceUrl     String?
  content       String             @db.Text
  status        String             @default("draft") // draft | active | superseded
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  uploadedById  String?
  uploadedBy    Employee?          @relation("KnowledgeUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  publishedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  relationsFrom DocumentRelation[] @relation("FromDoc")
  relationsTo   DocumentRelation[] @relation("ToDoc")

  @@index([bankCode, domain])
  @@index([status])
  @@index([uploadedById])
}

model DocumentRelation {
  id           String            @id @default(cuid())
  fromDocId    String
  toDocId      String
  relationType String // amends | supersedes | replaces_clause
  note         String?           @db.Text
  fromDoc      KnowledgeDocument @relation("FromDoc", fields: [fromDocId], references: [id], onDelete: Cascade)
  toDoc        KnowledgeDocument @relation("ToDoc", fields: [toDocId], references: [id], onDelete: Cascade)

  @@index([fromDocId])
  @@index([toDocId])
}

/// Audit log demo tối thiểu (không thay SIEM)
model AuditEvent {
  id         String   @id @default(cuid())
  bankCode   String   @default("SHB")
  actorId    String
  action     String // task_run.create | approval.approve | knowledge.publish | mcp.connector.set_enabled ...
  resource   String // TaskRun:id | TaskStep:id | KnowledgeDocument:id | McpConnector:capability
  detailJson Json?
  createdAt  DateTime @default(now())

  @@index([bankCode, createdAt])
  @@index([actorId])
  @@index([action])
}
